import {
    Button,
    ComboBox,
    GroupBox,
    HorizontalBox,
    LineEdit,
    ListView,
    VerticalBox,
} from "std-widgets.slint";

export struct UiSnapshot {
    name: string,
    created_at: string,
}

export struct UiInstance {
    name: string,
    status: string,
    arch: string,
    image: string,
    ip: string,
    memory: string,
    cpu: string,
    workspace_path: string,
    is_running: bool,
    snapshots: [UiSnapshot],
}

export component AppWindow inherits Window {
    title: "IncusCubby";
    preferred-width: 1020px;
    preferred-height: 700px;

    in property <[UiInstance]> instances: [];
    in-out property <int> selected_index: -1;
    in property <bool> has_selection: false;
    in property <UiInstance> selected_instance;
    in property <bool> busy: false;
    in property <string> status_message: "";
    in property <string> socket_warning: "";
    in property <string> confirm_message: "";
    in-out property <string> workspace_edit_text: "";

    callback refresh();
    callback select_instance(int);
    callback create_instance(string, string, string, string, string);
    callback start_instance(string);
    callback stop_instance(string);
    callback request_delete_instance(string);
    callback set_workspace_mount(string, string);
    callback open_shell(string);
    callback open_codium(string);
    callback open_zed(string);
    callback create_snapshot(string, string);
    callback request_restore_snapshot(string, string);
    callback request_delete_snapshot(string, string);
    callback confirm_action();
    callback cancel_confirm();

    VerticalBox {
        HorizontalBox {
            Text {
                text: "IncusCubby";
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.status_message != "": Text {
                text: root.status_message;
                vertical-alignment: center;
            }

            Button {
                text: root.busy ? "Working..." : "Refresh";
                enabled: !root.busy;
                clicked => {
                    root.refresh();
                }
            }
        }

        if root.socket_warning != "": GroupBox {
            title: "Incus Socket Warning";
            Text {
                text: root.socket_warning;
                wrap: word-wrap;
            }
        }

        if root.confirm_message != "": GroupBox {
            title: "Confirm Action";
            HorizontalBox {
                Text {
                    text: root.confirm_message;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }

                Button {
                    text: "Confirm";
                    enabled: !root.busy;
                    clicked => {
                        root.confirm_action();
                    }
                }

                Button {
                    text: "Cancel";
                    clicked => {
                        root.cancel_confirm();
                    }
                }
            }
        }

        GroupBox {
            title: "Create Sandbox";
            VerticalBox {
                HorizontalBox {
                    name_input := LineEdit {
                        placeholder-text: "Sandbox name (e.g. dev-rust)";
                        enabled: !root.busy;
                    }

                    image_combo := ComboBox {
                        model: ["debian/12", "debian/13", "ubuntu/24.04", "ubuntu/26.04", "alpine/3.24", "archlinux", "fedora/44"];
                        current-value: "debian/12";
                        enabled: !root.busy;
                        selected(val) => {
                            image_input.text = val;
                        }
                    }

                    image_input := LineEdit {
                        text: "debian/12";
                        placeholder-text: "Image alias";
                        enabled: !root.busy;
                    }

                    mem_combo := ComboBox {
                        model: ["2GiB", "4GiB", "8GiB", "16GiB"];
                        current-value: "4GiB";
                        enabled: !root.busy;
                    }

                    cpu_combo := ComboBox {
                        model: ["1", "2", "4", "8"];
                        current-value: "2";
                        enabled: !root.busy;
                    }
                }

                HorizontalBox {
                    ws_create_input := LineEdit {
                        placeholder-text: "Optional host workspace path (mounted at /workspace, e.g. ~/projects/app)";
                        enabled: !root.busy;
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: "Create";
                        enabled: !root.busy && name_input.text != "" && image_input.text != "";
                        clicked => {
                            root.create_instance(
                                name_input.text,
                                image_input.text,
                                mem_combo.current-value,
                                cpu_combo.current-value,
                                ws_create_input.text
                            );
                            name_input.text = "";
                        }
                    }
                }
            }
        }

        HorizontalBox {
            vertical-stretch: 1;

            GroupBox {
                title: "Sandboxes";
                horizontal-stretch: 1;
                min-width: 280px;

                if root.instances.length == 0: Text {
                    text: "No sandboxes found.";
                }

                if root.instances.length > 0: ListView {
                    for inst[idx] in root.instances: HorizontalBox {
                        Button {
                            text: (idx == root.selected_index ? "> " : "") + inst.name + " [" + inst.status + "]";
                            horizontal-stretch: 1;
                            clicked => {
                                root.select_instance(idx);
                            }
                        }
                    }
                }
            }

            GroupBox {
                title: "Details";
                horizontal-stretch: 2;

                if !root.has_selection: Text {
                    text: "Select a sandbox from the list.";
                }

                if root.has_selection: VerticalBox {
                    HorizontalBox {
                        Text {
                            text: root.selected_instance.name;
                            font-size: 16px;
                            font-weight: 700;
                        }

                        Text {
                            text: "(" + root.selected_instance.status + ")";
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Image: " + root.selected_instance.image + " | Arch: " + root.selected_instance.arch + " | CPU: " + root.selected_instance.cpu;
                    }

                    Text {
                        text: "IP: " + root.selected_instance.ip + " | Memory: " + root.selected_instance.memory;
                    }

                    Text {
                        text: "Workspace (/workspace): " + (root.selected_instance.workspace_path != "" ? root.selected_instance.workspace_path : "none");
                    }

                    HorizontalBox {
                        LineEdit {
                            text <=> root.workspace_edit_text;
                            placeholder-text: "Host directory path to mount at /workspace";
                            enabled: !root.busy;
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Mount";
                            enabled: !root.busy && root.workspace_edit_text != "";
                            clicked => {
                                root.set_workspace_mount(root.selected_instance.name, root.workspace_edit_text);
                            }
                        }

                        Button {
                            text: "Unmount";
                            enabled: !root.busy && root.selected_instance.workspace_path != "";
                            clicked => {
                                root.set_workspace_mount(root.selected_instance.name, "");
                            }
                        }
                    }

                    HorizontalBox {
                        Button {
                            text: "Start";
                            enabled: !root.busy && !root.selected_instance.is_running;
                            clicked => {
                                root.start_instance(root.selected_instance.name);
                            }
                        }

                        Button {
                            text: "Stop";
                            enabled: !root.busy && root.selected_instance.is_running;
                            clicked => {
                                root.stop_instance(root.selected_instance.name);
                            }
                        }

                        Button {
                            text: "Shell";
                            enabled: root.selected_instance.is_running;
                            clicked => {
                                root.open_shell(root.selected_instance.name);
                            }
                        }

                        Button {
                            text: "Codium";
                            clicked => {
                                root.open_codium(root.selected_instance.workspace_path);
                            }
                        }

                        Button {
                            text: "Zed";
                            clicked => {
                                root.open_zed(root.selected_instance.workspace_path);
                            }
                        }

                        Button {
                            text: "Delete";
                            enabled: !root.busy && !root.selected_instance.is_running;
                            clicked => {
                                root.request_delete_instance(root.selected_instance.name);
                            }
                        }
                    }

                    GroupBox {
                        title: "Snapshots";
                        vertical-stretch: 1;

                        VerticalBox {
                            HorizontalBox {
                                snap_input := LineEdit {
                                    placeholder-text: "Snapshot name (e.g. clean-base)";
                                    enabled: !root.busy;
                                }

                                Button {
                                    text: "Take Snapshot";
                                    enabled: !root.busy && snap_input.text != "";
                                    clicked => {
                                        root.create_snapshot(root.selected_instance.name, snap_input.text);
                                        snap_input.text = "";
                                    }
                                }
                            }

                            if root.selected_instance.snapshots.length == 0: Text {
                                text: "No snapshots.";
                            }

                            if root.selected_instance.snapshots.length > 0: ListView {
                                for snap in root.selected_instance.snapshots: HorizontalBox {
                                    Text {
                                        text: snap.name + " (" + snap.created_at + ")";
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    Button {
                                        text: "Restore";
                                        enabled: !root.busy;
                                        clicked => {
                                            root.request_restore_snapshot(root.selected_instance.name, snap.name);
                                        }
                                    }

                                    Button {
                                        text: "Delete";
                                        enabled: !root.busy;
                                        clicked => {
                                            root.request_delete_snapshot(root.selected_instance.name, snap.name);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
