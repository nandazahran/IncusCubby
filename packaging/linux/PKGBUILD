# Maintainer: Nanda Zahran <https://github.com/nandazahran>
pkgname=incus-cubby
pkgver=0.1.1
pkgrel=1
pkgdesc="Native Linux desktop GUI for managing local Incus/LXC developer sandboxes"
arch=('x86_64' 'aarch64')
url="https://github.com/nandazahran/IncusCubby"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'fontconfig' 'freetype2')
makedepends=('cargo' 'cmake' 'pkgconf')
optdepends=(
  'incus: local daemon and interactive shell attachment'
  'vscodium: IDE workspace integration'
  'zed: IDE workspace integration'
)
# Released source tarball (requires public repo or authenticated fetch).
source=("https://github.com/nandazahran/IncusCubby/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('123441a9fe827bf469446578ddbd07e00d5481ce99ac39c710a57937c7cc7016')

prepare() {
  cd "${srcdir}/IncusCubby-${pkgver}"
  cargo fetch --locked
}

build() {
  cd "${srcdir}/IncusCubby-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo build --frozen --release
}

check() {
  cd "${srcdir}/IncusCubby-${pkgver}"
  export CARGO_TARGET_DIR="${srcdir}/target"
  cargo test --frozen
}

package() {
  cd "${srcdir}/IncusCubby-${pkgver}"
  install -Dm755 "${srcdir}/target/release/incus-cubby" "$pkgdir/usr/bin/incus-cubby"
  install -Dm644 "packaging/linux/io.github.nandazahran.incuscubby.desktop" \
    "$pkgdir/usr/share/applications/io.github.nandazahran.incuscubby.desktop"
  install -Dm644 "packaging/linux/io.github.nandazahran.incuscubby.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/io.github.nandazahran.incuscubby.png"
  install -Dm644 "ui/icons/incuscubby.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.nandazahran.incuscubby.svg"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
